      "name": "Crear Clientes",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Successful POST request\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const fechaHoy = new Date();\r",
              "\r",
              "const year = fechaHoy.getFullYear();\r",
              "\r",
              "const month = String(fechaHoy.getMonth() + 1).padStart(2, '0');\r",
              "\r",
              "const day = String(fechaHoy.getDate()).padStart(2, '0');\r",
              "\r",
              "const fecha = `${year}-${month}-${day}`;\r",
              "\r",
              "pm.variables.set(\"fechaAlta\", fecha);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"Belen77\",\n    \"apellidoRazonSocial\": \"Diaz\",\n    \"documentoCuit\": \"223434553\",\n    \"direccion\": \"Rojas 1234\",\n    \"telefono\": \"11223344\",\n    \"email\": \"belen123@gmail.com\",\n    \"tipoCliente\": null,\n    \"activo\": false,\n    \"saldoPendiente\": 0.0,\n    \"fechaAlta\": \"{{fechaAlta}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/agregar",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "agregar"
          ]
        },
        "description": "This is a POST request, submitting data to an API via the request body. This request submits JSON data, and the data is reflected in the response.\n\nA successful POST request typically returns a `200 OK` or `201 Created` response code."
      },
